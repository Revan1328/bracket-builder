@page "/"
@using BracketBuilder.Blazor.Services
@inject BracketBuilderService BracketService

<PageTitle>Bracket Builder</PageTitle>

<div class="container mt-5">
    <h1 class="text-center mb-4">March Madness Bracket Builder</h1>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <button class="btn btn-primary btn-lg w-100 mb-4" @onclick="GenerateBracket" disabled="@isRunning">
                @if (isRunning)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    <span>Generating...</span>
                }
                else
                {
                    <span>Generate Bracket</span>
                }
            </button>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger mb-4" role="alert">
                    <strong>Error:</strong> @errorMessage
                    <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
                </div>
            }

            <div class="bracket-output border p-4 bg-light" style="height: 500px; overflow-y: auto; font-family: monospace;">
                @foreach (var output in outputs)
                {
                    @if (output.IsBlank)
                    {
                        <div></div>
                    }
                    else if (output.IsHeader)
                    {
                        <div style="color: @GetColorCode(output.Color); font-weight: bold; margin-top: 15px;">
                            @output.Message
                        </div>
                    }
                    else
                    {
                        <div style="color: @GetColorCode(output.Color);">
                            @output.Message
                        </div>
                    }
                }
            </div>

            <div class="mt-4 text-center">
                <p class="text-muted">
                    Currently has teams for the 2026 tournament. Results for each round start at the upper-left quadrant of the bracket, go down into the lower-left quadrant, then go to the upper-right quadrant and down. If a line is red, that means the team that won had a higher numbered seed than the team they beat (i.e. it was an upset).
                </p>
            </div>
            <div class="mt-4 text-center">
                <p class="text-muted">
                    The winner of each game is determined by taking the seed of each team and finding the difference between them; that value is then <a href="https://github.com/Revan1328/bracket-builder/blob/main/BracketBuilder.Blazor/Services/BracketBuilderService.cs#L181" target="_blank">passed into a map</a> that is used to determine the odds of the team with the higher numbered seed winning. For example, if two 8-seeds play against each other, the difference between their seed values is 0, so the odds are 50/50. But if a 1-seed plays against a 16-seed, the difference is 15, so the odds given for the 16-seed to win is 1/10000.
                </p>
            </div>
        </div>
    </div>
</div>

@code {
    private List<BracketOutput> outputs = new();
    private bool isRunning = false;
    private Action<BracketOutput>? bracketOutputHandler;
    private string? errorMessage;

    private async Task GenerateBracket()
    {
        try
        {
            isRunning = true;
            errorMessage = null;
            outputs.Clear();

            // Unsubscribe previous handler if it exists
            if (bracketOutputHandler != null)
            {
                BracketService.OnOutput -= bracketOutputHandler;
            }

            // Create and subscribe the new handler
            // Use InvokeAsync to marshal updates back to the UI thread
            bracketOutputHandler = (output) =>
            {
                _ = InvokeAsync(async () =>
                {
                    try
                    {
                        outputs.Add(output);
                        StateHasChanged();
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"Error in output handler: {ex}");
                        errorMessage = $"Error processing output: {ex.Message}";
                    }
                });
            };

            BracketService.OnOutput += bracketOutputHandler;

            // Run on a background thread to prevent UI blocking
            await Task.Run(() =>
            {
                BracketService.RunBracket();
            });
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            Console.WriteLine($"Error: {ex}");
        }
        finally
        {
            // Ensure cleanup even if an error occurs
            isRunning = false;
            StateHasChanged();
        }
    }

    private string GetColorCode(string color) => color switch
    {
        "cyan" => "#00D9FF",
        "red" => "#FF4444",
        _ => "#000000"
    };
}
